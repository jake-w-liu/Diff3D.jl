% ----------------------------------------------------------------------
% Shared layout optimization for long mathematical derivations.
% These settings preserve the 11 pt document font while reducing only
% avoidable inter-display whitespace and allowing Beamer to fill continuation
% frames automatically.
% ----------------------------------------------------------------------
\RequirePackage{etoolbox}
\setbeamersize{text margin left=0.60cm,text margin right=0.60cm}
\setlength{\emergencystretch}{1.5em}
\newcommand{\sfmptemplatespacing}{%
  \setlength{\abovedisplayskip}{3pt plus 1pt minus 1pt}%
  \setlength{\belowdisplayskip}{3pt plus 1pt minus 1pt}%
  \setlength{\abovedisplayshortskip}{2pt plus 1pt minus 1pt}%
  \setlength{\belowdisplayshortskip}{2pt plus 1pt minus 1pt}%
  \setlength{\jot}{2pt}%
  \setlength{\itemsep}{2pt plus 1pt minus 1pt}%
  \setlength{\parskip}{2pt plus 1pt minus 1pt}%
}
\AtBeginDocument{\sfmptemplatespacing}
\apptocmd{\normalsize}{\sfmptemplatespacing}{}{}
\apptocmd{\small}{\sfmptemplatespacing}{}{}
\apptocmd{\footnotesize}{\sfmptemplatespacing}{}{}
\apptocmd{\scriptsize}{\sfmptemplatespacing}{}{}
\setbeamertemplate{frametitle continuation}{\insertcontinuationcountroman}
